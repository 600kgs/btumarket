# Global options: resolve the real visitor IP for requests that arrive
# through Cloudflare. Only connections FROM these ranges get their
# X-Forwarded-For honored - anyone hitting the origin IP directly keeps
# their raw peer address, so the forwarded header can't be spoofed.
# Ranges are Cloudflare's published list (https://www.cloudflare.com/ips/);
# they change rarely, but re-check that page if Cloudflare announces new ones.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

btumarket.ge, www.btumarket.ge {
    # Reject oversized request bodies at the proxy, so a huge fake "photo"
    # upload dies here instead of being read into the app's memory
    # (the backend checks 10MB, but only after reading the whole body).
    request_body {
        max_size 12MB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # script-src has no 'unsafe-inline': the built React app loads one
        # external module script and nothing else, so an injected inline
        # <script> (the classic stored-XSS payload) gets blocked by the
        # browser even if some future bug lets attacker HTML through.
        # style-src keeps 'unsafe-inline' - React writes inline style
        # attributes by design. accounts.google.com appears in script/frame/
        # connect because Google Sign-In loads its library, renders its
        # button in an iframe, and phones home from it - all three are
        # required for the button to work.
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self' https://accounts.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://accounts.google.com https://*.ingest.sentry.io https://cloudflareinsights.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        -Server
    }

    reverse_proxy 127.0.0.1:8001 {
        # Replace the client-influenced forwarded chain with the single
        # trusted value Caddy resolved via trusted_proxies above - the
        # backend reads exactly one IP, never a client-supplied list.
        header_up X-Forwarded-For {client_ip}
    }
}
