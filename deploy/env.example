# Copy to /home/ubuntu/btu/.env and fill in. chmod 600 .env
# Generate the secret with: python3 -c "import secrets; print(secrets.token_hex(32))"
MARKETPLACE_SECRET_KEY=PASTE_GENERATED_SECRET_HERE

# Postgres (Neon). Use the POOLED connection string, with the +psycopg
# driver marker - the app installs psycopg v3, not psycopg2.
MARKETPLACE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Redis, as reachable from inside the Compose network (the service name).
MARKETPLACE_REDIS_URL=redis://redis:6379/0

# Only BTU emails can register:
MARKETPLACE_ALLOWED_EMAIL_DOMAINS=btu.edu.ge

# Your own username gets admin powers (reports queue + delete any listing):
MARKETPLACE_ADMINS=your_username_here

# Email sending - Brevo free tier (300 emails/day). Sign up at brevo.com,
# then SMTP & API -> SMTP: copy the login + key here.
MARKETPLACE_SMTP_HOST=smtp-relay.brevo.com
MARKETPLACE_SMTP_PORT=587
MARKETPLACE_SMTP_USER=your_brevo_login
MARKETPLACE_SMTP_PASSWORD=your_brevo_smtp_key
MARKETPLACE_FROM_EMAIL=BTU Market <noreply@yourdomain.ge>

# Optional: "Sign in with Google" restricted to MARKETPLACE_ALLOWED_EMAIL_DOMAINS.
# Get this from Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application. Add your site's
# URL under "Authorized JavaScript origins" (e.g. https://yourdomain.ge).
# It's a Client ID, not a secret - safe to leave here. Leave blank to hide
# the Google button entirely (site works fine without it).
MARKETPLACE_GOOGLE_CLIENT_ID=

# Optional: error tracking. Free account at sentry.io -> create a Python/
# FastAPI project -> copy the DSN it gives you. Leave blank to skip Sentry
# entirely (nothing else changes - errors just aren't reported anywhere but
# journalctl).
MARKETPLACE_SENTRY_DSN=
