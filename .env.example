# Copy to .env (gitignored, never commit it) for local `docker compose up`.
# These are safe LOCAL DEV defaults - production values (real secret key,
# real SMTP, real allowed email domain) are set separately on the server.

MARKETPLACE_DEV=1
MARKETPLACE_REQUIRE_EMAIL_VERIFICATION=0
# Set to your own username to test the /admin page locally.
MARKETPLACE_ADMINS=your_username

# Dev-mode "emails" print to the container's console instead of sending;
# read verification/reset codes with `docker compose logs -f backend`.
PYTHONIOENCODING=utf-8

# Leave blank locally: with MARKETPLACE_ALLOWED_EMAIL_DOMAINS unset, any
# email can register - handy for testing without a real @btu.edu.ge address.
MARKETPLACE_ALLOWED_EMAIL_DOMAINS=

# Leave blank to hide the Google Sign-In button (site works fine without it).
MARKETPLACE_GOOGLE_CLIENT_ID=
